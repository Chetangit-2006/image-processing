//only  reading & showing the file
import cv2

img = cv2.imread("tomato.png", cv2.IMREAD_COLOR)

cv2.imshow("Image", img)
cv2.waitKey(0)
cv2.destroyAllWindows()





//Read Image using Matplotlib
import cv2
import matplotlib.pyplot as plt

img = cv2.imread("tomato.png")

plt.imshow(img)
plt.axis("off")
plt.waitforbuttonpress()
plt.close()





//Convert BGR to RGB
import cv2
import matplotlib.pyplot as plt

img = cv2.imread("geeks.png")

# Convert BGR to RGB
RGB_img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

# Display image
plt.imshow(RGB_img)
plt.axis("off")
plt.waitforbuttonpress()
plt.close()





